# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
# SQLite (default - no setup required)
DATABASE_URL=sqlite:///aquavision.db

# MySQL (uncomment and configure if using MySQL)
# DATABASE_URL=mysql+pymysql://username:password@localhost/aquavision

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# OpenWeatherMap API (for weather integration)
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# Server Configuration
PORT=5001
HOST=0.0.0.0

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
